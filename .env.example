# =============================================================================
# GymTech OS — Environment Variables Template
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# =============================================================================

# --- App / General ---
APP_ENV=development
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8787

# --- Authentication & Encryption ---
# Random 256-bit string for JWT session tokens: openssl rand -base64 32
JWT_SECRET=your-random-jwt-secret-here-minimum-32-chars

# (Optional) 256-bit hex key to encrypt Face ID embeddings at rest: openssl rand -hex 32
FACE_EMBEDDING_KEY=

# --- Cloudflare Turnstile (Bot Protection) ---
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email + SMS + WhatsApp (MSG91 — recommended, one account for all 3) ---
# https://msg91.com → API keys. Only the auth key is secret:
#   wrangler secret put MSG91_AUTH_KEY
# The remaining values can ALSO be set per-platform in Admin → Communications,
# which override these env fallbacks when filled in.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=GYMTEC
MSG91_EMAIL_FROM=GymTech <hello@gymtech.app>
MSG91_WA_NUMBER=
MSG91_SMS_FLOW_ID=
MSG91_WHATSAPP_TEMPLATE=
MSG91_WHATSAPP_LANGUAGE=en
EMAIL_FROM=GymTech <notifications@gymtech.app>

# --- Legacy Email (Resend, deprecated) ---
# Kept only so older deployments keep working. New setups: use MSG91 above.
# https://resend.com/api-keys
RESEND_API_KEY=

# --- Media & Member Photo Storage (Filebase S3-Compatible) ---
# https://filebase.com
FILEBASE_ENDPOINT=https://s3.filebase.com
FILEBASE_REGION=us-east-1
FILEBASE_BUCKET=gymtech-media
FILEBASE_ACCESS_KEY_ID=
FILEBASE_SECRET_ACCESS_KEY=

# --- Web Frontend (Vite) ---
# Leave empty for same-origin dev/prod. Set to http://localhost:8787 if running Vite separately.
VITE_API_BASE_URL=
VITE_TURNSTILE_SITE_KEY=
