# =============================================================================
# GymTech OS — Master Environment Variables Template (.env.example)
# =============================================================================
# All environment variables and secrets used across the system are documented
# in this single file.
#
# QUICK START GUIDE:
# ------------------
# 1. For Vite Frontend & Drizzle CLI (.env):
#      cp .env.example .env
#
# 2. For Cloudflare Worker Local Dev (Wrangler reads .dev.vars):
#      cp .env.example .dev.vars
#    (or cp .env.example apps/api/.dev.vars)
#
# 3. For Production Cloudflare Workers:
#    - Non-secret variables are set in wrangler.jsonc (under vars / env.*.vars).
#    - Secrets MUST be set via Cloudflare CLI:
#        npx wrangler secret put <SECRET_NAME> --env production
#
# SECURITY WARNING:
# NEVER commit .env or .dev.vars to version control.
# =============================================================================

# =============================================================================
# 1. CORE APPLICATION & SERVER RUNTIME
# =============================================================================
# Environment mode: 'development' | 'staging' | 'production' | 'preview'
# When 'development', secure cookies are disabled on HTTP and dev Turnstile bypass is allowed.
APP_ENV=development

# Base URL of the web application. Used for JWT token issuer ('iss'),
# media signed download URL composition, and links in outgoing emails.
APP_URL=http://localhost:5173

# Comma-separated allowlist of origins permitted to make cross-origin API requests.
# Wildcard '*' is strictly forbidden when credentials (cookies) are enabled.
CORS_ORIGINS=http://localhost:5173,http://localhost:8787,http://127.0.0.1:8787


# =============================================================================
# 2. AUTHENTICATION & ENCRYPTION (SECRETS)
# =============================================================================
# Secret key used for signing and verifying HMAC-SHA256 JWT session tokens.
# Minimum 32 characters. Generate with: openssl rand -base64 32
# Production: wrangler secret put JWT_SECRET
JWT_SECRET=change_me_to_a_random_jwt_secret_at_least_32_chars_long

# (Optional) 256-bit key used to derive a Key-Encryption-Key (KEK) via PBKDF2
# for AES-GCM encryption of member Face ID biometric embeddings at rest.
# Generate with: openssl rand -hex 32
# Production: wrangler secret put FACE_EMBEDDING_KEY
FACE_EMBEDDING_KEY=gymtech_local_dev_face_embedding_key_32chars!


# =============================================================================
# 3. CLOUDFLARE TURNSTILE (CAPTCHA / BOT PROTECTION)
# =============================================================================
# Cloudflare Turnstile dashboard: https://dash.cloudflare.com/?to=/:account/turnstile
# The values below are Cloudflare's official testing keys that ALWAYS PASS in development.

# Public site key embedded in the frontend widget (used by apps/web)
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Secret key used by the backend API to verify tokens against challenges.cloudflare.com
# Production: wrangler secret put TURNSTILE_SECRET_KEY
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA


# =============================================================================
# 4. COMMUNICATIONS & NOTIFICATIONS (MSG91 — UNIFIED EMAIL, SMS, WHATSAPP)
# =============================================================================
# MSG91 provides Email, SMS, and WhatsApp through a single provider account.
# Portal: https://msg91.com
# Note: These values can also be configured dynamically per-platform in
# Admin -> Communications, which will override these environment fallbacks.

# MSG91 API Authentication Key (keep secret)
# Production: wrangler secret put MSG91_AUTH_KEY
MSG91_AUTH_KEY=

# 6-character alphanumeric Sender ID approved in MSG91 for transactional SMS (e.g., GYMTEC)
MSG91_SENDER_ID=GYMTEC

# Default sender identity for MSG91 transactional emails
MSG91_EMAIL_FROM=GymTech <hello@gymtech.app>

# General system email sender fallback
EMAIL_FROM=GymTech <notifications@gymtech.app>

# WhatsApp Business sender phone number with country code (e.g., 919876543210)
MSG91_WA_NUMBER=

# MSG91 Flow ID for transactional SMS (OTP / payment alerts)
MSG91_SMS_FLOW_ID=

# Approved MSG91 WhatsApp template slug/name
MSG91_WHATSAPP_TEMPLATE=

# Language code for WhatsApp template (default: en)
MSG91_WHATSAPP_LANGUAGE=en


# =============================================================================
# 5. LEGACY EMAIL SERVICE (RESEND — DEPRECATED)
# =============================================================================
# Kept for backward compatibility with older deployments.
# New deployments should configure MSG91 above.
# https://resend.com/api-keys
# Production: wrangler secret put RESEND_API_KEY
RESEND_API_KEY=


# =============================================================================
# 6. MEDIA & FILE STORAGE (FILEBASE S3-COMPATIBLE / IPFS)
# =============================================================================
# Used for member profile photos, workout plan artwork, and invoice attachments.
# Filebase portal: https://filebase.com
# Object keys are strictly tenant-isolated as `${gymId}/${objectKey}`.

FILEBASE_ENDPOINT=https://s3.filebase.com
FILEBASE_REGION=us-east-1
FILEBASE_BUCKET=gymtech-media

# Filebase S3 Credentials
# Production: wrangler secret put FILEBASE_ACCESS_KEY_ID
# Production: wrangler secret put FILEBASE_SECRET_ACCESS_KEY
FILEBASE_ACCESS_KEY_ID=
FILEBASE_SECRET_ACCESS_KEY=


# =============================================================================
# 7. DATABASE & DRIZZLE TOOLING (CLOUDFLARE D1)
# =============================================================================
# Local D1 database name or ID (default for local wrangler: gymtechapp or gymtech-dev)
D1_DATABASE_ID=gymtechapp

# Cloudflare Account ID & API Token: Required ONLY when using `drizzle-kit pull`
# or running Drizzle Kit HTTP driver against Cloudflare D1 (see drizzle.config.ts)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_TOKEN=

# Optional seed admin password override used by `apps/api/scripts/seed.mjs`
# Defaults to 'Password123!' when not set.
SEED_PASSWORD=Password123!


# =============================================================================
# 8. WEB FRONTEND (VITE CLIENT — apps/web)
# =============================================================================
# In production and standard dev, the API and React SPA are co-hosted on the same
# origin Worker, so leave VITE_API_BASE_URL empty.
# If running Vite dev server (`pnpm dev:web` on :5173) separately from Wrangler API (:8787),
# set this to: http://localhost:8787
VITE_API_BASE_URL=

# Turnstile site key exposed to the Vite browser bundle
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA


# =============================================================================
# 9. CLOUDFLARE WORKER INFRASTRUCTURE BINDINGS REFERENCE
# =============================================================================
# The following are Cloudflare Worker resource bindings defined in wrangler.jsonc.
# They are bound automatically by Cloudflare Workers runtime:
#
# - DB            : D1 Database binding (gymtechapp)
# - RATELIMIT_KV  : Workers KV namespace for sliding-window rate limiting
# - DENYLIST_KV   : Workers KV namespace for revoked JWT tokens (jti)
# - ASSETS        : Workers Static Assets binding to serve apps/web/dist
# - MEDIA_BUCKET  : (Deprecated) R2 Bucket binding
# =============================================================================
