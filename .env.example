# GymTech OS — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# =============================================================================
# App (shared)
# =============================================================================

# Random secret for JWT signing — generate with: openssl rand -base64 32
JWT_SECRET=

# Cloudflare Turnstile site/secret keys (https://dash.cloudflare.com/turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# =============================================================================
# API (Cloudflare Workers)
# =============================================================================

# D1 Database ID — from `wrangler d1 list`
D1_DATABASE_ID=

# R2 Bucket for file uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# AWS S3 (optional, for S3-compatible storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# Filebase (S3-compatible CDN — https://filebase.com)
FILEBASE_ACCESS_KEY=
FILEBASE_SECRET_KEY=
FILEBASE_BUCKET=

# SendGrid (email notifications) — https://sendgrid.com
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hello@gymtech.in

# =============================================================================
# Web (Vite)
# =============================================================================

# API URL (leave empty for same-origin)
VITE_API_URL=
VITE_TURNSTILE_SITE_KEY=
