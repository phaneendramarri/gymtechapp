# Local development variables for Cloudflare Workers
# Copy this file to .dev.vars and fill in values.

# Random secret for JWT signing — generate with: openssl rand -base64 32
JWT_SECRET=change_me_to_a_random_secret_at_least_32_chars_long

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# D1 Database (local dev — run `pnpm --filter=@gymtech/api db:push` first)
D1_DATABASE_ID=gymtech-dev

# Filebase / R2 (optional for local dev)
# FILEBASE_ACCESS_KEY=
# FILEBASE_SECRET_KEY=
# FILEBASE_BUCKET=
