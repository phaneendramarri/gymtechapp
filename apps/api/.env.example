# =============================================================================
# GymTech OS — API Environment Variables Template (.env.example)
# =============================================================================
# Copy this file to .dev.vars for local development with Wrangler:
#   cp .env.example .dev.vars
# Or copy to .env for local script execution:
#   cp .env.example .env
#
# Production Cloudflare Worker secrets must be uploaded via:
#   npx wrangler secret put <SECRET_NAME> --env production
# =============================================================================

# --- App / Server ---
APP_ENV=development
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8787,http://127.0.0.1:8787

# --- Authentication & Encryption (Secrets) ---
JWT_SECRET=change_me_to_a_random_jwt_secret_at_least_32_chars_long
FACE_EMBEDDING_KEY=gymtech_local_dev_face_embedding_key_32chars!

# --- Cloudflare Turnstile (Bot Protection) ---
# Cloudflare test keys (always pass in non-production environments):
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Communications (MSG91) ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=GYMTEC
MSG91_EMAIL_FROM=GymTech <hello@gymtech.app>
EMAIL_FROM=GymTech <notifications@gymtech.app>
MSG91_WA_NUMBER=
MSG91_SMS_FLOW_ID=
MSG91_WHATSAPP_TEMPLATE=
MSG91_WHATSAPP_LANGUAGE=en

# --- Legacy Email (Resend - deprecated fallback) ---
RESEND_API_KEY=

# --- Media Storage (Filebase S3-Compatible) ---
FILEBASE_ENDPOINT=https://s3.filebase.com
FILEBASE_REGION=us-east-1
FILEBASE_BUCKET=gymtech-media
FILEBASE_ACCESS_KEY_ID=
FILEBASE_SECRET_ACCESS_KEY=

# --- Database & Tooling ---
D1_DATABASE_ID=gymtechapp
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_TOKEN=
SEED_PASSWORD=Password123!

# --- Web Frontend (Vite) ---
VITE_API_BASE_URL=
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
