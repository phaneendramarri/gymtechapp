# Dependencies
node_modules/
.pnpm-store/

# Production & Build outputs
dist/
build/
.wrangler/
*.tsbuildinfo
AUDIT_REPORT.md

# Stray transpiled emits — there is no emit step in this repo
# (tsc --noEmit everywhere; Wrangler handles bundling). Any *.js next to
# a *.ts/*.tsx is a leftover from a previous build setup and must be deleted.
apps/**/src/**/*.js
apps/**/src/**/*.js.map
apps/**/src/**/*.d.ts
apps/**/src/**/*.d.ts.map
packages/**/src/**/*.js
packages/**/src/**/*.js.map
packages/**/src/**/*.d.ts
packages/**/src/**/*.d.ts.map

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
test-results/
playwright-report/
blob-report/
coverage/

# Environment files
.env
.env.*
!.env.example
# Per-machine secret overrides (never committed)
.env.staging.local
.env.production.local
.env.development.local

# Cloudflare Wrangler — secrets & local dev state.
# `.dev.vars` is the Wrangler equivalent of `.env` for `wrangler dev` and
# contains secret keys (JWT_SECRET, etc.).
# `*.pem` / `*.key` covers ad-hoc key files used for local signing.
.dev.vars
.dev.vars.*
.wrangler/
.dev/
.cloudflare/
*.pem
*.key
!*.pub.key

# IDE & System
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Database seed files & credentials
# NOTE: apps/api/seed/seed_production.sql is intentionally TRACKED — it
# contains only __PLACEHOLDER__ password hashes (filled at seed time by
# scripts/seed.mjs), no real credentials. The rules below target real dumps.
apps/api/seed/update_hash.sql
apps/api/seed/*prod*.sql
apps/api/seed/*hash*.sql
seed_*.sql
*.seed.sql
temp_*.sql
*.dump.sql
# Re-include the placeholder seed template (overrides the globs above —
# later patterns win). It carries no real credentials.
!apps/api/seed/seed_production.sql
.freebuff/
.kilo/

# Playwright HTML report output & live auth storage state (generated, never committed)
tests/e2e-live/report/
tests/e2e-live/.auth/

